# Strona Daniela — Caddy sam pobiera i odnawia certyfikat HTTPS (Let's Encrypt).
# __DOMAIN__ podmienia deploy/install.sh (albo cloud-init przy nowym serwerze).

__DOMAIN__ {
	root * /srv/daniel

	# pliki repozytorium, których nie pokazujemy publicznie
	@hidden path /.git* /deploy* /.nojekyll
	respond @hidden 404

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# strona, skrypty i style zawsze sprawdzane na serwerze (po zmianie od razu nowa wersja),
	# zdjęcia i fonty z dłuższą pamięcią podręczną
	@code path / *.html *.js *.css
	header @code Cache-Control "no-cache"
	header /assets/img/* Cache-Control "public, max-age=86400"
	header /assets/fonts/* Cache-Control "public, max-age=2592000"

	file_server
}

www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
